generator client {
  provider      = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  schemas  = ["flashcard"]
}

model Themes {
  id        Int      @id @default(autoincrement())
  name      String   @db.VarChar(100) @unique
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  card    FlashCard[]
  Question Questions[]

  @@schema("flashcard")
  @@map("themes")
}

model FlashCard {
  id        BigInt   @id @default(autoincrement())
  question  String   @db.VarChar(100)
  ask       String   @db.VarChar(255)
  design    CardDesign?
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  themeId Int    @map("theme_id")
  themes  Themes @relation(fields: [themeId], references: [id])

  @@schema("flashcard")
  @@map("flashcard")
}

model CardDesign {
  id        Int      @id @default(autoincrement())
  cardId    BigInt   @unique
  textColor TextColor
  font      Font
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  card FlashCard @relation(fields: [cardId], references: [id])

  @@schema("flashcard")
  @@map("card_design")
}

model QuestionDesign {
  id        Int      @id @default(autoincrement())
  questionsId BigInt @unique @map("questions_id")
  textColor TextColor
  font      Font
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  question Questions @relation(fields: [questionsId], references: [id])

  @@schema("flashcard")
  @@map("question_design")
}

model Questions {
  id          BigInt   @id @default(autoincrement())
  // significado para enunciado de questao
  questionStem String   @db.Text()
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  // chaves estrangeiras
  themeId     Int @map("theme_id")
  design      QuestionDesign?
  alternatives Alternatives[]

  theme Themes @relation(fields: [themeId], references: [id])

  @@schema("flashcard")
  @@map("questions")
}

model Alternatives {
  id         BigInt  @id @default(autoincrement())
  questionId BigInt @map("question_id")
  options    String
  isCorrect  Boolean

  question Questions @relation(fields: [questionId], references: [id])

  @@schema("flashcard")
  @@map("alternatives")
}

enum TextColor {
  ROXO
  AZUL
  VERDE
  ROSA
  LARANJA

  @@schema("flashcard")
}

enum Font {
  ARIAL
  ROBOTO
  INTER

  @@schema("flashcard")
}
