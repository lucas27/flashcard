generator client {
  provider   = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Themes {
  id Int @id @default(autoincrement())
  name String @db.VarChar(100)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  card FlashCard[] // Um tema tem muitos cards
  Question Questions[]
}

model FlashCard {
  id BigInt @id @default(autoincrement())
  question String @db.VarChar(100)
  ask String @db.VarChar(255)
  design CardDesign?
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  themeId Int @map("theme_id")
  themes Themes @relation(fields: [themeId], references: [id])
}

model CardDesign {
  id Int @id @default(autoincrement())
  cardId BigInt @unique
  textColor TextColor
  font Font
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  card FlashCard @relation(fields: [cardId], references: [id])
}

model QuestionDesign {
  id Int @id @default(autoincrement())
  questionsId BigInt @unique
  textColor TextColor
  font Font
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  question Questions @relation(fields: [questionsId], references: [id])
}

model Questions {
  id BigInt @id @default(autoincrement())
  // significado para enunciado de questao
  questionStem String @db.Text()
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // chaves estrangeiras
  themeId Int
  design QuestionDesign?
  alternatives Alternatives[]
  
  theme Themes @relation(fields: [themeId], references: [id])
}

model Alternatives {
  id BigInt @id @default(autoincrement())
  questionId BigInt
  options String
  isCorrect Boolean

  question Questions @relation(fields: [questionId], references: [id])
}

enum TextColor {
  ROXO 
  AZUL
  VERDE
  ROSA
  LARANJA
}

enum Font {
  ARIAL
  ROBOTO
  INTER
}